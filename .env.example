# Copy this file to `.env` and fill in the values you need.
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows)
#
# Nothing here is required to *read* the code -- run `python -m pipeline.doctor`
# to see exactly which of these your configured pipeline actually needs.

# ── Twitch (REQUIRED — this is where clips come from) ────────────────────────
# Register an application at https://dev.twitch.tv/console/apps
#   OAuth Redirect URL: http://localhost   (unused, but the form demands one)
#   Category: Application Integration
# Then copy the Client ID and generate a Client Secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Gemini (OPTIONAL — improves selection quality and thumbnails) ────────────
# Get a key at https://aistudio.google.com/apikey
#
# Without this key the pipeline still runs end to end: the video judge falls
# back to local signals (api_judge.local_judge) and the thumbnail falls back to
# the free PIL renderer. You get a video either way, just a less well-curated one.
#
# NOTE: AI thumbnail generation (thumbnail.provider: gemini) needs BILLING
# enabled on the API project -- image models are not on the free tier.
# Set `thumbnail.provider: local` in config.yaml to stay entirely free.
GEMINI_API_KEY=

# ── OpenAI-compatible provider (OPTIONAL) ───────────────────────────────────
# Any role in the `llm:` block of config.yaml can point at an OpenAI-compatible
# endpoint: OpenRouter, Groq, Together, DeepSeek, LM Studio, vLLM, llama.cpp,
# or Ollama's own /v1 endpoint. Set base_url + model there, key here.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── Anthropic (OPTIONAL) ────────────────────────────────────────────────────
# Usable for the text roles (commentary, feedback classification).
# Not usable for `judge`, which needs native video understanding.
ANTHROPIC_API_KEY=

# ── Riot Games (OPTIONAL — Phase 2 match_linker stage, disabled by default) ──
# https://developer.riotgames.com
RIOT_API_KEY=
