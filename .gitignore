# secrets
.env
client_secret.json

# environments / caches
venv/
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# personal config overlays (config.kemono.yaml IS committed as a worked example)
pipeline/config.local*.yaml

# per-machine settings for the scheduled run — schedule, sleep-after, which
# overlay to use (auto_run.local.cmd.example IS committed)
auto_run.local.cmd

# runtime data (clips, renders, caches, tokens)
data/

# training datasets (large; regenerable via pipeline.tools.collect_training_data)
data/training/

# music tracks are local-only (royalty-free NCS, listed in config video.music_tracks with
# attribution; bg.mp3 is generated via `python -m pipeline.tools.gen_music`). Not committed
# (binary size + redistribution). See assets/music/README.md to re-source them.
assets/music/*.mp3

# generated nameplate SFX (rebuild with: python -m pipeline.tools.gen_sfx)
assets/sfx/

# archived pre-pivot code (local only)
_archive/

# local Claude Code permissions (machine-specific)
.claude/settings.local.json

# one-off batch scripts (not part of the distributed setup)
run_days.bat

# this machine's nightly coordinator, bridging this project with an unrelated
# repo (a memecoin trading system's WSL workstation worker) that happens to
# share this PC. Machine-local glue, not something the Clips project itself
# should know about or version. run_daily_auto.bat's NIGHTLY_COORDINATED hook
# is the one generic, project-agnostic seam this repo owns; everything below
# is the other side of that seam and lives only on this machine.
run_combined_nightly.ps1
run_memecoin_worker_wsl.bat
run_video_coordinated.bat
setup_combined_schedule.bat
setup_combined_schedule.ps1
README_NIGHTLY_SETUP.txt

# NB: .env.example, LICENSE, pyproject.toml, tests/ and docs/ ARE committed.
# If you add a personal secret, put it in .env — never in config.yaml.